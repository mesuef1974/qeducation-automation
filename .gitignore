backend/.neo_profile/
session_cookies.json

# حالة التشغيل المحلية (بيانات المنصة تبقى على الجهاز - PDPPL)
*.sqlite3
*.sqlite3-journal

# مخرجات مولّدة من db/build_db.py
db/*.db
db/*.xlsx

# بيئة بايثون وأدوات
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.ruff_cache/
.env
*.log

# صندوق المراسلة بين جلسات Claude (محلي، خارج git)
.local/

# ويندوز
desktop.ini
.no_autostart
Thumbs.db

# الواجهة الأمامية: الحزم والمخرجات المبنية (تُبنى بـ npm run build)
frontend/node_modules/
frontend/dist/

# نسخ PDF المولّدة من التقرير
docs/report/out/

# صور المحتوى المولّدة
backend/media/

# صندوق المراسلة بين الجلسات ومواضع قراءتها (محلي، خارج git)
.local/

